{
  "schema": "miniray.trace-contract/v1",
  "name": "ordinary_task_success",
  "title": "ordinary task: central publication receipts, owner readiness and reply custody retirement",
  "participants": {
    "gcs": "GCS publication coordinator",
    "core_worker": "Owner CoreWorker",
    "node": "NodeServer",
    "worker": "Execution Worker",
    "owner_service": "OwnerService (Driver owner)"
  },
  "input_bindings": [
    "task_id"
  ],
  "events": [
    {
      "key": "node_registered",
      "component": "gcs",
      "event": "node_registered"
    },
    {
      "key": "node_ready",
      "component": "node",
      "event": "process_ready"
    },
    {
      "key": "worker_ready",
      "component": "worker",
      "event": "process_ready"
    },
    {
      "key": "submitted",
      "component": "core_worker",
      "event": "task_submitted",
      "fields": {
        "attempt_id": "$attempt_id",
        "object_id": "$object_id",
        "task_id": "$task_id"
      },
      "max_count": 1
    },
    {
      "key": "dependencies_ready",
      "component": "core_worker",
      "event": "dependency_ready",
      "fields": {
        "attempt_id": "$attempt_id",
        "dependency_count": "0",
        "task_id": "$task_id"
      },
      "max_count": 1,
      "show_fields": [
        "dependency_count"
      ]
    },
    {
      "key": "lease_requested",
      "component": "core_worker",
      "event": "lease_requested",
      "fields": {
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "task_id": "$task_id"
      }
    },
    {
      "key": "lease_granted",
      "component": "core_worker",
      "event": "lease_granted",
      "fields": {
        "lease_id": "$lease_id",
        "node_id": "$node_id",
        "task_id": "$task_id",
        "worker_id": "$worker_id"
      },
      "max_count": 1
    },
    {
      "key": "pushed",
      "component": "core_worker",
      "event": "task_pushed",
      "fields": {
        "task_id": "$task_id",
        "worker_id": "$worker_id"
      },
      "max_count": 1
    },
    {
      "key": "worker_started",
      "component": "worker",
      "event": "task_started",
      "fields": {
        "attempt_id": "$attempt_id",
        "task_id": "$task_id"
      },
      "max_count": 1
    },
    {
      "key": "worker_succeeded",
      "component": "worker",
      "event": "task_succeeded",
      "fields": {
        "attempt_id": "$attempt_id",
        "task_id": "$task_id"
      },
      "max_count": 1
    },
    {
      "key": "owner_ready",
      "component": "core_worker",
      "event": "output_owner_ready",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "return_count": "1"
      },
      "max_count": 1,
      "show_fields": [
        "return_count"
      ]
    },
    {
      "key": "node_complete",
      "component": "node",
      "event": "output_lease_completed",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "status": "SUCCEEDED",
        "state": "COMPLETED",
        "released": "true"
      },
      "show_fields": [
        "status",
        "released"
      ]
    },
    {
      "key": "payload_retired",
      "component": "core_worker",
      "event": "output_payload_retired",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest"
      }
    },
    {
      "key": "task_finished",
      "component": "core_worker",
      "event": "task_finished",
      "fields": {
        "attempt_id": "$attempt_id",
        "object_id": "$object_id",
        "status": "SUCCEEDED",
        "task_id": "$task_id"
      },
      "max_count": 1,
      "show_fields": [
        "status"
      ]
    },
    {
      "key": "object_ready",
      "component": "core_worker",
      "event": "object_ready",
      "fields": {
        "attempt_id": "$attempt_id",
        "object_id": "$object_id",
        "return_index": "0",
        "storage": "INLINE",
        "task_id": "$task_id"
      },
      "max_count": 1,
      "show_fields": [
        "storage"
      ]
    },
    {
      "key": "gcs_intent",
      "component": "gcs",
      "event": "enhanced_publication_stage",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "object_id": "$object_id",
        "stage": "INTENT",
        "request_type": "BeginPublication"
      },
      "show_fields": [
        "stage",
        "request_type"
      ]
    },
    {
      "key": "gcs_prepared",
      "component": "gcs",
      "event": "enhanced_publication_stage",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "object_id": "$object_id",
        "stage": "PREPARED",
        "request_type": "PrepareGraph"
      },
      "show_fields": [
        "stage",
        "request_type"
      ]
    },
    {
      "key": "gcs_armed",
      "component": "gcs",
      "event": "enhanced_publication_stage",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "object_id": "$object_id",
        "stage": "ARMED",
        "request_type": "ArmTask"
      },
      "show_fields": [
        "stage",
        "request_type"
      ]
    },
    {
      "key": "gcs_terminal",
      "component": "gcs",
      "event": "enhanced_publication_stage",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "object_id": "$object_id",
        "stage": "TERMINAL",
        "request_type": "RecordTerminal"
      },
      "show_fields": [
        "stage",
        "request_type"
      ]
    },
    {
      "key": "gcs_committed",
      "component": "gcs",
      "event": "enhanced_publication_stage",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "object_id": "$object_id",
        "stage": "COMMITTED",
        "request_type": "CommitGraph"
      },
      "show_fields": [
        "stage",
        "request_type"
      ]
    },
    {
      "key": "gcs_adopted",
      "component": "gcs",
      "event": "enhanced_publication_stage",
      "fields": {
        "task_id": "$task_id",
        "attempt_id": "$attempt_id",
        "lease_id": "$lease_id",
        "manifest_digest": "$manifest_digest",
        "object_id": "$object_id",
        "stage": "ADOPTED",
        "request_type": "RecordAdoption"
      },
      "show_fields": [
        "stage",
        "request_type"
      ]
    }
  ],
  "rpcs": [
    {
      "key": "lease_rpc",
      "client": "core_worker",
      "server": "node",
      "handler": "request_worker_lease",
      "after_event": "lease_requested",
      "before_event": "lease_granted",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "push_rpc",
      "client": "core_worker",
      "server": "worker",
      "handler": "push_task",
      "after_event": "pushed",
      "before_event": "owner_ready",
      "server_event": "worker_succeeded",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "start_rpc",
      "client": "worker",
      "server": "node",
      "client_component": "transport",
      "handler": "start_worker_lease",
      "after_event": "worker_started",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "prepare_rpc",
      "client": "worker",
      "server": "node",
      "client_component": "transport",
      "handler": "prepare_output_publication",
      "after_event": "worker_started",
      "before_event": "worker_succeeded",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "register_handoff_rpc",
      "client": "node",
      "server": "owner_service",
      "handler": "register_output_handoff",
      "before_event": "node_complete",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "complete_rpc",
      "client": "worker",
      "server": "node",
      "client_component": "transport",
      "handler": "complete_worker_lease",
      "after_event": "worker_started",
      "before_event": "worker_succeeded",
      "server_event": "node_complete",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "retire_rpc",
      "client": "core_worker",
      "server": "node",
      "handler": "ack_output_publication_adopted",
      "after_event": "owner_ready",
      "before_event": "task_finished",
      "reply_event": "payload_retired",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "gcs_intent_rpc",
      "client": "node",
      "server": "gcs",
      "handler": "enhanced_publication",
      "server_event": "gcs_intent",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "gcs_prepared_rpc",
      "client": "node",
      "server": "gcs",
      "handler": "enhanced_publication",
      "server_event": "gcs_prepared",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "gcs_armed_rpc",
      "client": "node",
      "server": "gcs",
      "handler": "enhanced_publication",
      "server_event": "gcs_armed",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "gcs_terminal_rpc",
      "client": "core_worker",
      "server": "gcs",
      "handler": "enhanced_publication",
      "server_event": "gcs_terminal",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "gcs_committed_rpc",
      "client": "core_worker",
      "server": "gcs",
      "handler": "enhanced_publication",
      "server_event": "gcs_committed",
      "round_trip": true,
      "reply_ok": "true"
    },
    {
      "key": "gcs_adopted_rpc",
      "client": "core_worker",
      "server": "gcs",
      "handler": "enhanced_publication",
      "server_event": "gcs_adopted",
      "round_trip": true,
      "reply_ok": "true"
    }
  ],
  "orders": [
    {
      "before": "submitted",
      "after": "dependencies_ready"
    },
    {
      "before": "dependencies_ready",
      "after": "lease_requested"
    },
    {
      "before": "lease_requested",
      "after": "lease_rpc.request_sent"
    },
    {
      "before": "lease_rpc.reply_received",
      "after": "lease_granted"
    },
    {
      "before": "lease_granted",
      "after": "pushed"
    },
    {
      "before": "pushed",
      "after": "push_rpc.request_sent"
    },
    {
      "before": "push_rpc.request_received",
      "after": "worker_started"
    },
    {
      "before": "worker_started",
      "after": "start_rpc.request_sent"
    },
    {
      "before": "start_rpc.reply_received",
      "after": "prepare_rpc.request_sent"
    },
    {
      "before": "prepare_rpc.reply_received",
      "after": "complete_rpc.request_sent"
    },
    {
      "before": "complete_rpc.request_received",
      "after": "node_complete"
    },
    {
      "before": "node_complete",
      "after": "complete_rpc.reply_sent"
    },
    {
      "before": "complete_rpc.reply_received",
      "after": "worker_succeeded"
    },
    {
      "before": "worker_succeeded",
      "after": "push_rpc.reply_sent"
    },
    {
      "before": "retire_rpc.reply_received",
      "after": "payload_retired"
    },
    {
      "before": "payload_retired",
      "after": "task_finished"
    },
    {
      "before": "task_finished",
      "after": "object_ready"
    },
    {
      "before": "prepare_rpc.request_received",
      "after": "register_handoff_rpc.request_sent"
    },
    {
      "before": "register_handoff_rpc.reply_received",
      "after": "prepare_rpc.reply_sent"
    },
    {
      "before": "push_rpc.reply_received",
      "after": "owner_ready"
    },
    {
      "before": "owner_ready",
      "after": "retire_rpc.request_sent"
    },
    {
      "before": "register_handoff_rpc.reply_received",
      "after": "gcs_intent_rpc.request_sent"
    },
    {
      "before": "gcs_intent_rpc.reply_received",
      "after": "gcs_prepared_rpc.request_sent"
    },
    {
      "before": "gcs_prepared_rpc.reply_received",
      "after": "gcs_armed_rpc.request_sent"
    },
    {
      "before": "gcs_armed_rpc.reply_received",
      "after": "prepare_rpc.reply_sent"
    },
    {
      "before": "push_rpc.reply_received",
      "after": "gcs_terminal_rpc.request_sent"
    },
    {
      "before": "gcs_terminal_rpc.reply_received",
      "after": "gcs_committed_rpc.request_sent"
    },
    {
      "before": "gcs_committed_rpc.reply_received",
      "after": "owner_ready"
    },
    {
      "before": "owner_ready",
      "after": "gcs_adopted_rpc.request_sent"
    },
    {
      "before": "gcs_adopted_rpc.reply_received",
      "after": "retire_rpc.request_sent"
    }
  ],
  "forbidden": [
    {
      "component": "gcs",
      "event_prefixes": [
        "task_",
        "lease_"
      ]
    },
    {
      "component": "core_worker",
      "event": "task_failed",
      "fields": {
        "task_id": "$task_id"
      }
    },
    {
      "component": "core_worker",
      "event": "task_retried",
      "fields": {
        "task_id": "$task_id"
      }
    },
    {
      "component": "gcs",
      "event": "rpc_request_received",
      "fields": {
        "handler": "report_output_publication"
      }
    },
    {
      "component": "gcs",
      "event": "rpc_request_received",
      "fields": {
        "handler": "register_output_handoff"
      }
    }
  ],
  "render_order": [
    "submitted",
    "dependencies_ready",
    "lease_rpc.request_sent",
    "lease_rpc.reply_received",
    "lease_granted",
    "push_rpc.request_sent",
    "worker_started",
    "start_rpc.request_sent",
    "start_rpc.reply_received",
    "prepare_rpc.request_sent",
    "register_handoff_rpc.request_sent",
    "register_handoff_rpc.reply_received",
    "gcs_intent_rpc.request_sent",
    "gcs_intent",
    "gcs_intent_rpc.reply_received",
    "gcs_prepared_rpc.request_sent",
    "gcs_prepared",
    "gcs_prepared_rpc.reply_received",
    "gcs_armed_rpc.request_sent",
    "gcs_armed",
    "gcs_armed_rpc.reply_received",
    "prepare_rpc.reply_received",
    "complete_rpc.request_sent",
    "node_complete",
    "complete_rpc.reply_received",
    "worker_succeeded",
    "push_rpc.reply_received",
    "gcs_terminal_rpc.request_sent",
    "gcs_terminal",
    "gcs_terminal_rpc.reply_received",
    "gcs_committed_rpc.request_sent",
    "gcs_committed",
    "gcs_committed_rpc.reply_received",
    "owner_ready",
    "gcs_adopted_rpc.request_sent",
    "gcs_adopted",
    "gcs_adopted_rpc.reply_received",
    "retire_rpc.request_sent",
    "retire_rpc.reply_received",
    "payload_retired",
    "task_finished",
    "object_ready"
  ]
}
