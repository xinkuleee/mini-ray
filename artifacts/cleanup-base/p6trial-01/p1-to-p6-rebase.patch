+"""Per-call input custody for ordinary Task submission.
+
+This scope trial extracts preparation/commit/abort of submitted input holds.
+The instance ends with Core admission; it is neither a Task success registry
+nor a second owner/recovery authority. Core reserves identity and commits
+owner/recovery/lineage/enqueue under its existing composition lock.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Callable, Mapping, Protocol
+
+from . import protocol
+from .dependency import ContainedRef, encode_task_argument, nested_references, top_level_references
+from .errors import SystemTaskError
+from .foreign_lineage import ForeignLineageEdge, ForeignLineageRole
+from .ids import ObjectID, TaskID, WorkerID
+from .transport import Address
+
+
+@dataclass(frozen=True)
+class TaskDependencyGuard:
+    """Stable owner credential held for one logical submitted task."""
+
+    object_id: ObjectID
+    owner_worker_id: WorkerID
+    owner_address: Address
+    borrower_worker_id: WorkerID
+    borrower_token: str
+    hold: protocol.TaskReferenceHold
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.hold, protocol.TaskReferenceHold):
+            raise TypeError("foreign dependency hold must be a TaskReferenceHold")
+        if self.hold.kind is not protocol.TaskReferenceHoldKind.RETAINED:
+            raise ValueError("foreign dependency hold must have RETAINED kind")
+        if self.hold.submitting_worker_id != self.borrower_worker_id:
+            raise ValueError(
+                "foreign dependency hold submitter must match its borrower"
+            )
+
+
+class SubmissionReference(Protocol):
+    object_id: ObjectID
+    owner_worker_id: WorkerID
+    owner_address: Address | None
+    borrower_token: str | None
+
+    @property
+    def closed(self) -> bool: ...
+
+
+class SubmissionInputOwner(Protocol):
+    def add_submitted_reference(self, object_id: ObjectID, token: protocol.TaskReferenceHold) -> bool: ...
+    def release_submitted_reference(self, object_id: ObjectID, token: protocol.TaskReferenceHold) -> bool: ...
+
+
+@dataclass(frozen=True)
+class SubmissionInputCustody:
+    owner: SubmissionInputOwner
+    as_reference: Callable[[object], SubmissionReference | None]
+    require_local: Callable[[ObjectID], object]
+    retain_foreign: Callable[[TaskDependencyGuard], None]
+    release_foreign: Callable[[TaskDependencyGuard], None]
+    record_orphan: Callable[[TaskDependencyGuard], None]
+    enqueue_gc: Callable[[ObjectID], None]
+
+
+@dataclass(frozen=True)
+class EncodedTaskCall:
+    args: tuple[protocol.TaskArg, ...]
+    kwargs: tuple[tuple[str, protocol.TaskArg], ...]
+
+
+@dataclass(frozen=True)
+class SubmittedInputs:
+    protected_dependencies: tuple[ObjectID, ...]
+    foreign_guards: tuple[TaskDependencyGuard, ...]
+    nested_local_holds: tuple[ObjectID, ...]
+    nested_foreign_guards: tuple[TaskDependencyGuard, ...]
+
+
+class TaskSubmissions:
+    """One submission's effect ledger; successful admission consumes it.
+
+    Mutations are sequential on the submitting thread. commit_local_inputs is
+    called only inside Core's owner/recovery composition lock; preparing and
+    releasing foreign credentials remain outside that lock. Its immutable
+    input metadata joins the existing PendingTask. No whole Core is accepted.
+    """
+
+    def __init__(self, worker_id: WorkerID, submitted: protocol.TaskReferenceHold,
+                 retained: protocol.TaskReferenceHold, inline_budget: int,
+                 custody: SubmissionInputCustody) -> None:
+        self._worker_id, self._submitted, self._retained = worker_id, submitted, retained
+        self._inline_budget, self._custody = inline_budget, custody
+        self._protected: list[ObjectID] = []
+        self._foreign_guards: list[TaskDependencyGuard] = []
+        self._nested_local_holds: list[ObjectID] = []
+        self._nested_foreign_guards: list[TaskDependencyGuard] = []
+        self._nested_transfers: dict[tuple[ObjectID, WorkerID], protocol.NestedReferenceTransfer] = {}
+        self._nested_sources: dict[tuple[ObjectID, WorkerID], SubmissionReference] = {}
+        self._references: tuple[ContainedRef, ...] = ()
+        self._lineage_dependency_ids: tuple[ObjectID, ...] = ()
+
+    @property
+    def lineage_dependency_ids(self) -> tuple[ObjectID, ...]:
+        return self._lineage_dependency_ids
+
+    def prepare_call(self, args: tuple[object, ...], kwargs: Mapping[str, object]) -> EncodedTaskCall:
+        inline_bytes = 0
+
+        def encode(value: object) -> protocol.TaskArg:
+            nonlocal inline_bytes
+            argument = encode_task_argument(value, serializer="cloudpickle",
+                                            export_nested_ref=self._export_nested_ref)
+            if not isinstance(argument, protocol.InlineArg):
+                return argument
+            next_inline_bytes = inline_bytes + len(argument.data)
+            if next_inline_bytes > self._inline_budget:
+                raise ValueError(
+                    "task arguments exceed the inline budget; use ray.put(value) "
+                    "and pass its ObjectRef for large inputs"
+                )
+            inline_bytes = next_inline_bytes
+            return argument
+
+        return EncodedTaskCall(tuple(encode(value) for value in args),
+                               tuple((name, encode(value)) for name, value in kwargs.items()))
+
+    def _export_nested_ref(self, value: object) -> protocol.NestedReferenceTransfer:
+        reference = self._custody.as_reference(value)
+        if reference is None:
+            raise TypeError("nested task references must be ObjectRef values")
+        if reference.closed:
+            raise ValueError("cannot submit a closed nested ObjectRef")
+        key = reference.object_id, reference.owner_worker_id
+        previous_source = self._nested_sources.setdefault(key, reference)
+        if previous_source.owner_address != reference.owner_address:
+            raise ValueError("duplicate nested ObjectRef has conflicting owner credentials")
+        previous = self._nested_transfers.get(key)
+        if previous is not None:
+            return previous
+        address = reference.owner_address
+        if address is None:
+            raise ValueError("nested ObjectRef has no reachable owner endpoint")
+        hold = self._submitted if reference.owner_worker_id == self._worker_id else self._retained
+        transfer = protocol.NestedReferenceTransfer(reference.object_id, reference.owner_worker_id, address, hold)
+        if reference.owner_worker_id == self._worker_id:
+            self._custody.require_local(reference.object_id)
+            self._custody.owner.add_submitted_reference(reference.object_id, self._submitted)
+            self._nested_local_holds.append(reference.object_id)
+        else:
+            if reference.borrower_token is None:
+                raise ValueError("foreign nested ObjectRef is detached from its owner protocol")
+            guard = TaskDependencyGuard(reference.object_id, reference.owner_worker_id, address,
+                                        self._worker_id, reference.borrower_token, self._retained)
+            # Save the exact intent before the potentially ambiguous retain.
+            self._nested_foreign_guards.append(guard)
+            self._custody.retain_foreign(guard)
+        self._nested_transfers[key] = transfer
+        return transfer
+
+    def prepare_dependencies(self, spec: protocol.TaskSpec, args: tuple[object, ...],
+                             kwargs: Mapping[str, object]) -> None:
+        encoded = spec.args + tuple(value for _, value in spec.kwargs)
+        self._references = top_level_references(encoded)
+        nested_manifest = nested_references(encoded)
+        if {(item.object_id, item.owner_worker_id): item for item in nested_manifest} != self._nested_transfers:
+            raise SystemTaskError("encoded nested-reference manifest changed submission identity")
+        for item in nested_manifest:
+            hold = self._submitted if item.owner_worker_id == self._worker_id else self._retained
+            if item.hold != hold:
+                raise SystemTaskError("nested-reference manifest changed its Task hold")
+        self._lineage_dependency_ids = tuple(dict.fromkeys(
+            tuple(item.object_id for item in self._references if item.owner_worker_id == self._worker_id)
+            + tuple(item.object_id for item in nested_manifest if item.owner_worker_id == self._worker_id)))
+        sources: dict[tuple[ObjectID, WorkerID], SubmissionReference] = {}
+        for value in tuple(args) + tuple(kwargs.values()):
+            source = self._custody.as_reference(value)
+            if source is not None:
+                key = source.object_id, source.owner_worker_id
+                previous = sources.get(key)
+                if previous is None or ((previous.closed or previous.owner_address is None
+                                         or previous.borrower_token is None)
+                                        and not source.closed and source.owner_address is not None
+                                        and source.borrower_token is not None):
+                    sources[key] = source
+        for reference in self._references:
+            if reference.owner_worker_id == self._worker_id:
+                continue
+            key = reference.object_id, reference.owner_worker_id
+            existing = next((guard for guard in self._nested_foreign_guards
+                             if (guard.object_id, guard.owner_worker_id) == key), None)
+            if existing is not None:
+                self._foreign_guards.append(existing)
+                continue
+            source = sources.get(key)
+            if (source is None or source.closed or source.owner_address is None
+                    or source.borrower_token is None):
+                raise ValueError("foreign ObjectRef dependency is detached from its owner protocol")
+            guard = TaskDependencyGuard(reference.object_id, reference.owner_worker_id, source.owner_address,
+                                        self._worker_id, source.borrower_token, self._retained)
+            self._foreign_guards.append(guard)
+            self._custody.retain_foreign(guard)
+
+    def foreign_lineage_edges(self, task_id: TaskID) -> tuple[ForeignLineageEdge, ...]:
+        roles: dict[tuple[ObjectID, WorkerID], ForeignLineageRole] = {}
+        guards: dict[tuple[ObjectID, WorkerID], TaskDependencyGuard] = {}
+        for guard in self._nested_foreign_guards:
